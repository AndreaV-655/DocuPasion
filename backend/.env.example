# ===== DocuPasion - Variables de Entorno (Plantilla) =====
# Copia este archivo a ".env" y completa los valores.
# NUNCA subas ".env" al repositorio de Git.
# Ejecuta sql/docupasion.sql en phpMyAdmin para crear la BD antes de iniciar.

# MySQL (phpMyAdmin / XAMPP) - Ejecuta sql/docupasion.sql primero
DATABASE_URL=mysql+pymysql://docupasion:DocuPasion2024!@127.0.0.1:3306/docupasion?charset=utf8mb4

# Alternativa: SQLite (sin MySQL) descomenta esta línea y comenta la de arriba
# DATABASE_URL=sqlite:///./docupasion.db

SECRET_KEY=genera-una-clave-secreta-segura
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=uploads

# Carpeta del frontend (SPA) servida por la API
FRONTEND_DIR=../frontend

# Claves de IA (dejar vacías para modo demo sin LLM)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# Parámetros de RAG / Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64